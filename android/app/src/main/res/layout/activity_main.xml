<?xml version="1.0" encoding="utf-8"?>
<!-- App shell: navigation rail on the left, one screen visible on the right.
     The rail scrolls on screens too short for all entries (phones in landscape). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0f1215"
    android:orientation="horizontal">

    <ScrollView
        android:id="@+id/railScroll"
        android:layout_width="100dp"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/rail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#0f1215"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="10dp"
            android:paddingBottom="12dp" />
    </ScrollView>

    <FrameLayout
        android:id="@+id/screens"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <include layout="@layout/screen_map" />

        <FrameLayout
            android:id="@+id/screenHost"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#121518"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
