From 3257741085f00baf55682146c28dd5df9bf5f494 Mon Sep 17 00:00:00 2001
From: ets2nav <ets2nav@localhost>
Date: Mon, 14 Sep 2026 22:31:16 +0300
Subject: [PATCH 5/5] ets2nav-local: clear error when a game's map data was not
 built

Data is built only for the installed games; playing another one now logs
what to do instead of a bare ENOENT.
---
 packages/apis/navigation/infra/lookups/service.ts | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/packages/apis/navigation/infra/lookups/service.ts b/packages/apis/navigation/infra/lookups/service.ts
index 4894ea6..4ceb4fb 100644
--- a/packages/apis/navigation/infra/lookups/service.ts
+++ b/packages/apis/navigation/infra/lookups/service.ts
@@ -1,3 +1,5 @@
+import fs from 'node:fs';
+import path from 'node:path';
 import type { GameContext } from '../../domain/game-context';
 import type { LookupData, LookupService } from '../../domain/lookup-data';
 import { loadLookupData } from './loader';
@@ -16,6 +18,14 @@ export class LookupServiceImpl implements LookupService {
   getData(context: GameContext): LookupData {
     let data = this.loaded.get(context.map);
     if (!data) {
+      const zip = path.join(this.dataDir, `${context.map}-navigation.zip`);
+      if (!fs.existsSync(zip)) {
+        // Data is only built for the games installed at build time.
+        throw new Error(
+          `no map data for ${context.map === 'usa' ? 'ATS' : 'ETS2'} (${zip}): ` +
+            'click "Update map" in the Rig Buddy window to build it',
+        );
+      }
       const start = Date.now();
       data = loadLookupData(this.dataDir, context.map);
       this.loaded.set(context.map, data);
