diff --git a/packages/apis/navigation/infra/per-map.ts b/packages/apis/navigation/infra/per-map.ts
new file mode 100644
index 0000000..6b878b1
--- /dev/null
+++ b/packages/apis/navigation/infra/per-map.ts
@@ -0,0 +1,17 @@
+import type { GameContext } from '../domain/game-context';
+
+type GameMap = GameContext['map'];
+
+// ets2nav-local: memoizes a per-map factory, so a map's worker pools (which
+// get a copy of that map's data) are only created once the map is in use.
+export function perMap<T>(create: (map: GameMap) => T): (map: GameMap) => T {
+  const made = new Map<GameMap, T>();
+  return map => {
+    let value = made.get(map);
+    if (value === undefined) {
+      value = create(map);
+      made.set(map, value);
+    }
+    return value;
+  };
+}
