From 22bd1c1cd40f9ac1bf7e764753f3ba515db1bb9c Mon Sep 17 00:00:00 2001
From: Orhan <spitintomyjar@protonmail.com>
Date: Sun, 8 Nov 2026 00:31:33 +0300
Subject: [PATCH] Map generator: a ferry no known DLC combination covers does
 not stop the build

ferryToFeature asserted that some DLC guard covers both ends of a ferry. A ferry between two regions the guard table does not combine (seen on ETS2 1.62.1 for some installations) threw, and no map was built at all. It now uses the guard of the ferry's own end and logs a warning.
---
 packages/clis/generator/geo-json/map.ts | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/packages/clis/generator/geo-json/map.ts b/packages/clis/generator/geo-json/map.ts
index eb72759..b2951cf 100644
--- a/packages/clis/generator/geo-json/map.ts
+++ b/packages/clis/generator/geo-json/map.ts
@@ -1078,6 +1078,15 @@ function ferryToFeature(
       }
     }
   }
+  if (dlcGuard === undefined) {
+    // No known DLC combination covers both ends of this ferry (a game update can add a ferry between two DLC regions
+    // the table has not seen). Needing the DLCs of the ferry's own end is the closest answer, and a map with one
+    // ferry gated a little off is better than no map at all.
+    logger.warn(
+      `no DLC guard covers both ends of the ferry ${ferry.token}; using ${ferry.dlcGuard} (the other end: ${conn.dlcGuard})`,
+    );
+    dlcGuard = ferry.dlcGuard;
+  }
   dlcGuard = assertExists(dlcGuard);
 
   const nameAndCountry = [ferry, conn]
-- 
2.43.0

