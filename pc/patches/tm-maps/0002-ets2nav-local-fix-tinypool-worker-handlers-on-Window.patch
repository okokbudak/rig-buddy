diff --git a/packages/apis/navigation/infra/workers/find-route-worker-wrapper.js b/packages/apis/navigation/infra/workers/find-route-worker-wrapper.js
index 22e78f6..6366316 100644
--- a/packages/apis/navigation/infra/workers/find-route-worker-wrapper.js
+++ b/packages/apis/navigation/infra/workers/find-route-worker-wrapper.js
@@ -26,7 +26,9 @@ void api.unregister();
 // number of times the large `routeContext` object is cloned; `routeContext` is
 // only cloned MAX_THREADS time instead of being cloned every time `findRoutes`
 // is called.
-export default {
-  default: options =>
-    findRoutes({ ...options, routeContext: workerData.routeContext }),
-};
+// ets2nav-local: export a plain function. On Windows tinypool falls back to
+// importing via a file:// URL and then only unwraps one `default` level, so
+// the `{ default: fn }` object form fails there ("No handler function").
+export default function findRoutesWithContext(options) {
+  return findRoutes({ ...options, routeContext: workerData.routeContext });
+}
