 1 file changed, 2 insertions(+)

diff --git a/packages/clis/generator/commands/prefab-curves.ts b/packages/clis/generator/commands/prefab-curves.ts
index 12568f9..5dcac2a 100644
--- a/packages/clis/generator/commands/prefab-curves.ts
+++ b/packages/clis/generator/commands/prefab-curves.ts
@@ -91,6 +91,8 @@ export function handler(args: BuilderArguments<typeof builder>) {
   const tsMapData = readMapData(args.inputDir, args.map, {
     focus: focusOptions,
     mapDataKeys: prefabCurveMapDataKeys,
+    // hidden prefabs are junctions too: the road surface needs their lanes
+    includeHiddenRoadsAndPrefabs: true,
   });
 
   writeGeojsonFile(
