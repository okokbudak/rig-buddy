diff --git a/packages/clis/parser/game-files/scs-archive.ts b/packages/clis/parser/game-files/scs-archive.ts
index f6fa495..f5c0610 100644
--- a/packages/clis/parser/game-files/scs-archive.ts
+++ b/packages/clis/parser/game-files/scs-archive.ts
@@ -43,6 +43,17 @@ const EntryHeader = new r.Struct({
   someByte: r.uint8,
 });
 
+// HashFS version 1 (what mods are usually packed with): a flat 32-byte entry
+// table right after the 32-byte header; no metadata table.
+const EntryV1 = new r.Struct({
+  hash: uint64le,
+  offset: uint64le,
+  flags: r.uint32le, // 1 = directory, 2 = zlib, 4 = verify, 8 = encrypted
+  crc: r.uint32le,
+  size: r.uint32le,
+  compressedSize: r.uint32le,
+});
+
 export const enum MetadataType {
   IMG = 1,
   SAMPLE = 2,
@@ -183,7 +194,7 @@ export class ScsArchive {
     return (
       this.header.magic === 'SCS#' &&
       this.header.hashMethod === 'CITY' &&
-      this.header.version === 2
+      (this.header.version === 1 || this.header.version === 2)
     );
   }
 
@@ -192,6 +203,9 @@ export class ScsArchive {
     if (this.entries) {
       return this.entries;
     }
+    if (this.header.version === 1) {
+      return (this.entries = this.parseEntriesV1());
+    }
 
     const entryHeaders = new r.Array(
       EntryHeader,
@@ -222,6 +236,40 @@ export class ScsArchive {
     return this.entries;
   }
 
+  private parseEntriesV1(): Entries {
+    // the v1 header shares its first 16 bytes with v2's: entry count at 12, and
+    // where v2 keeps the entry table's compressed size, v1 has the table's offset
+    const table = Buffer.alloc(EntryV1.size() * this.header.entryTableCount);
+    fs.readSync(this.fd, table, {
+      length: table.length,
+      position: this.header.entryTableCompressedSize,
+    });
+    const directories: DirectoryEntry[] = [];
+    const files: FileEntry[] = [];
+    for (const e of new r.Array(
+      EntryV1,
+      this.header.entryTableCount,
+    ).fromBuffer(table)) {
+      assert((e.flags & 8) === 0, 'encrypted archive entries are not supported');
+      const metadata: EntryMetadata = {
+        hash: e.hash,
+        offset: e.offset,
+        compressedSize: e.compressedSize,
+        uncompressedSize: e.size,
+        compression: e.flags & 2 ? Compression.ZLIB : Compression.NONE,
+        isDirectory: (e.flags & 1) !== 0,
+      };
+      if (metadata.isDirectory) {
+        directories.push(
+          new ScsArchiveDirectoryV1(this.fd, metadata, this.scsSource),
+        );
+      } else {
+        files.push(new ScsArchiveFile(this.fd, metadata, this.scsSource));
+      }
+    }
+    return { directories: createStore(directories), files: createStore(files) };
+  }
+
   private createMetadataMap(
     entryHeaders: BaseOf<typeof EntryHeader>[],
   ): Map<number, MetadataEntry> {
@@ -651,3 +699,25 @@ class ScsArchiveDirectory extends ScsArchiveEntry implements DirectoryEntry {
     this.files = files;
   }
 }
+
+/** Version 1 directory listing: one name per line, sub-directories prefixed with "*". */
+class ScsArchiveDirectoryV1 extends ScsArchiveEntry implements DirectoryEntry {
+  readonly type = 'directory';
+  readonly subdirectories: readonly string[];
+  readonly files: readonly string[];
+
+  constructor(fd: number, metadata: EntryMetadata, scsSource: string) {
+    super(fd, metadata, scsSource);
+
+    const subdirectories: string[] = [];
+    const files: string[] = [];
+    for (const raw of this.read().toString().split('\n')) {
+      const line = raw.trim();
+      if (!line) continue;
+      if (line.startsWith('*')) subdirectories.push(line.substring(1));
+      else files.push(line);
+    }
+    this.subdirectories = subdirectories;
+    this.files = files;
+  }
+}
