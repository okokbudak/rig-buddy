 import { ajv } from './sii-schemas';
 import { jsonConverter } from './sii-visitors';
 
+/**
+ * Unit names ("model.Ays_Locker") are case-insensitive tokens; map mods write
+ * them in mixed case, which the token-shaped schemas and lookups don't expect.
+ */
+function lowercaseUnitNames<J>(json: J): J {
+  const obj = json as Record<string, unknown>;
+  for (const [cls, units] of Object.entries(obj)) {
+    if (units && typeof units === 'object' && !Array.isArray(units)) {
+      obj[cls] = Object.fromEntries(
+        Object.entries(units).map(([name, unit]) => [name.toLowerCase(), unit]),
+      );
+    }
+  }
+  return json;
+}
+
 export function convertSiiToJson<T>(
   siiPath: string,
   entries: Entries,
@@ -61,7 +77,7 @@ export function convertSiiToJson<T>(
     throw new Error();
   }
 
-  const json = jsonConverter.convert(res.cst);
+  const json = lowercaseUnitNames(jsonConverter.convert(res.cst));
   const validate = ajv.compile(schema);
   if (validate(json)) {
     return json;
