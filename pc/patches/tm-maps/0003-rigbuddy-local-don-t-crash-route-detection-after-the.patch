From 241fa2f16e645ffffe15539319ec0a081f54c267 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Orhan=20K=C3=B6kbudak?= <spitintomyjar@protonmail.com>
Date: Mon, 14 Sep 2026 02:08:07 +0300
Subject: [PATCH 03/12] rigbuddy-local: don't crash route detection after the
 route is completed

---
 .../apis/navigation/domain/actor/detect-route-events.ts   | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/packages/apis/navigation/domain/actor/detect-route-events.ts b/packages/apis/navigation/domain/actor/detect-route-events.ts
index c7b4a5b..6a52a84 100644
--- a/packages/apis/navigation/domain/actor/detect-route-events.ts
+++ b/packages/apis/navigation/domain/actor/detect-route-events.ts
@@ -190,6 +190,14 @@ function isTruckOnRoute(
     return true;
   }
 
+  if (expectedItems.length === 0) {
+    // rigbuddy-local: the route has been completed (e.g. events were unpaused
+    // after the final segmentComplete); there's nothing left to match against.
+    // Upstream crashed here with `toString(undefined)`, failing telemetry.push
+    // and killing the telemetry client.
+    return true;
+  }
+
   if (typeof expectedItems[0] === 'symbol') {
     // skip over dummy expected items, because they only exist when neighbor
     // nodes repeat, or we're at a ferry terminal.
