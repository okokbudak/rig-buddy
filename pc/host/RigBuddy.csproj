<Project Sdk="Microsoft.NET.Sdk">

  <!-- Rig Buddy PC app: one tray program that runs everything the head unit
       needs (telemetry bridge and the Node services). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- the Windows 10 API projection: the system media sessions (Spotify, browsers, ...) for the music controls -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>RigBuddy</AssemblyName>
    <Product>Rig Buddy</Product>
    <Version>0.1.0</Version>
    <Copyright>Copyright (C) 2026 Orhan Kökbudak. GPL-3.0-or-later.</Copyright>
    <ApplicationIcon>rigbuddy.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.IO.Ports" Version="8.0.0" />
  </ItemGroup>

</Project>
