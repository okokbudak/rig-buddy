bin/
dist/
pc/host/bin/
pc/host/obj/
android/.gradle/
android/.kotlin/
android/build/
android/app/build/
android/local.properties
android/app/release/

# ---- local machine state ----
logs/
local/
dev/dev.env
*.log
*.err
.idea/
.vscode/
*.iml

# release signing key and its passwords: never commit
android/keystore.properties
*.jks
*.keystore
# built by pc/native/build-addons.sh (and in the release workflow)
pc/native/win-x64/
